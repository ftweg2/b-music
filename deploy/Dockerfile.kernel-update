# Build this update LOCALLY, against the previously verified runtime image.
# Both full and incremental builds install the same pinned requirements and code.
ARG BASE_IMAGE=bmusic-kernel:20260905-optimized
FROM ${BASE_IMAGE}
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN rm -f /app/app/tests/test_qr_capture_performance.py
COPY app /app/app
COPY docs /app/docs
